# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mails transacionais (Resend). Nunca use estas chaves em variáveis NEXT_PUBLIC_*.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=Jards <notificacoes@notify.seudominio.com>
TRANSACTIONAL_EMAIL_REPLY_TO=suporte@seudominio.com

# Identidade de empresas
NEXT_PUBLIC_LOGODOTDEV_TOKEN=
LOGODOTDEV_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PROFISSIONAL=
STRIPE_PRICE_SEAT=

# E-mail Google
GOOGLE_EMAIL_CLIENT_ID=
GOOGLE_EMAIL_CLIENT_SECRET=

# Google Calendar / Microsoft Outlook
CALENDAR_SYNC_ENABLED=false
CALENDAR_TOKEN_SECRET=
CALENDAR_SYNC_WEBHOOK_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
CALENDAR_TIME_ZONE=America/Sao_Paulo

# Supabase Edge Functions — extração assistida de orçamentos e comprovantes
# Configure como secret da função, nunca como NEXT_PUBLIC_*.
GOOGLE_AI_API_KEY=
# Opcional. Modelo Gemini das funções de IA; sem valor, cada uma usa o padrão do código
# (supabase/functions/_shared/modelo-ia.ts; o 2.5 Flash não atende mais contas novas).
GOOGLE_AI_MODEL=

# Notícias (legado; mantenha somente se o provedor GNews voltar a ser usado)
GNEWS_API_KEY=
